{
  "name": "remix-app-template-js",
  "private": true,
  "description": "Cleaned and secured Remix template",
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "bun run build:css && remix build",
    "build:css": "tailwindcss -o ./app/tailwind.css",
    "dev": "concurrently \"bun run dev:css\" \"remix dev\"",
    "dev:css": "tailwindcss -o ./app/tailwind.css --watch",
    "start": "remix-serve build"
  },
  "dependencies": {
    "@remix-run/node": "^2.17.4",
    "@remix-run/react": "^2.17.4",
    "@remix-run/serve": "^2.17.4",
    "concurrently": "^8.2.2",
    "dotenv": "^16.6.1",
    "mongoose": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.4",
    "@remix-run/eslint-config": "^2.17.4",
    "eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "braces": "^3.0.3",
    "cookie": "^0.6.0",
    "esbuild": "^0.20.2",
    "flatted": "^3.3.1",
    "js-yaml": "^4.1.0",
    "micromatch": "^4.0.7",
    "minimatch": "^9.0.4",
    "nanoid": "^3.3.7",
    "path-to-regexp": "^0.1.10",
    "qs": "^6.12.1",
    "rollup": "^4.17.2",
    "tar": "^6.2.1",
    "vite": "^5.2.11",
    "ws": "^8.17.0",
    "yaml": "^2.4.2"
  }
}
